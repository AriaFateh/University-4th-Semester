<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>far branches, forward and backward</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x30c7,0x2907,0x33ff,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x0000,0x2883,0x3337)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
0 0 0 0 0 0x0000 X X X X
C 0 0 0 0 X X X X X
# forward branch of +199 landed
0 0 0 0 0 0x00c8 X X X X
C 0 0 0 0 X X X X X
C 0 0 0 0 X X X X X
# backward branch of -201 landed
0 0 0 0 0 0x0001 X X X X
C 0 0 0 0 X X X X X
0 0 0x0001 0x0002 0 X X X 0x0007 X
</dataString></testData></entry></elementAttributes><pos x="0" y="0"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>LUI puts imm7 into bits 15..9</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2cc0,0x2d09,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
loop(i,2)
C 0 0 0 0 X X X X X
end loop
0 0 0x0001 0x0001 0 X X X 0x8000 X
0 0 0x0001 0x0002 0 X X X 0x1200 X
</dataString></testData></entry></elementAttributes><pos x="300" y="0"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>JR uses only the low 8 bits of Rs1</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2c89,0x1c97,0x3880,0x2981,0x2982,0x2983,0x2984,0x2989,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
loop(i,3)
C 0 0 0 0 X X X X X
end loop
# only the low 8 bits of R1 reach the PC
0 0 0 0 0 0x0007 X X X X
C 0 0 0 0 X X X X X
0 0 0x0001 0x0003 0 X X X 0x0009 X
</dataString></testData></entry></elementAttributes><pos x="600" y="0"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>JAL saves the return address in R7</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x3402,0x2905,0x33ff,0x2a08,0x3b80)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
0 0 0 0 0 0x0000 X X X X
C 0 0 0 0 X X X X X
# jumped into the subroutine
0 0 0 0 0 0x0003 X X X X
C 0 0 0 0 X X X X X
C 0 0 0 0 X X X X X
# and came back to the instruction after JAL
0 0 0 0 0 0x0001 X X X X
C 0 0 0 0 X X X X X
# R7 holds PC+1 of the JAL, zero extended into 16 bits
0 0 0x0001 0x0007 0 X X X 0x0001 X
0 0 0x0001 0x0004 0 X X X 0x0008 X
0 0 0x0001 0x0002 0 X X X 0x0005 X
</dataString></testData></entry></elementAttributes><pos x="900" y="0"/></visualElement>
    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>a predicated JAL that is not taken writes nothing</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2b95,0x2883,0x2904,0x0415,0x7401,0x2a86,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
loop(i,5)
C 0 0 0 0 X X X X X
end loop
# the conditional JAL was skipped, so R7 still holds the sentinel
0 0 0x0001 0x0007 0 X X X 0x0015 X
C 0 0 0 0 X X X X X
0 0 0x0001 0x0005 0 X X X 0x0006 X
</dataString></testData></entry></elementAttributes><pos x="1200" y="0"/></visualElement>
  </visualElements>
  <wires>
  </wires>
  <measurementOrdering/>
</circuit>
