<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>reset and fetch protocol</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2885,0x2909,0x0194,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
# after reset the PC is 0 and the first instruction is visible
0 0 0 0 0 0x0000 0x2885 0x0000 X X
# one clock pulse == exactly one instruction
C 0 0 0 0 X X X X X
0 0 0 0 0 0x0001 0x2909 X X X
C 0 0 0 0 X X X X X
0 0 0 0 0 0x0002 0x0194 X X X
C 0 0 0 0 X X X X X
0 0 0 0 0 0x0003 0x33ff X X X
# HALT is a branch to itself, so the PC stays on it for ever
loop(i,20)
C 0 0 0 0 X X X X X
end loop
0 0 0 0 0 0x0003 0x33ff X X X
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-80" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>reset from the middle of a program</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2885,0x2909,0x0194,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
loop(i,3)
C 0 0 0 0 X X X X X
end loop
0 0 0 0 0 0x0003 X X X X
0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
0 0 0 0 0 0x0000 0x2885 0x0000 X X
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="300" y="0"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>NOP changes nothing</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2895,0x3c00,0x3c00,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
loop(i,1)
C 0 0 0 0 X X X X X
end loop
0 0 0 0 0 0x0001 0x3c00 X X X
loop(i,2)
C 0 0 0 0 X X X X X
end loop
0 0 0x0001 0x0001 0 0x0003 X 0x0000 0x0015 X
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="600" y="0"/>
    </visualElement>
  </visualElements>
  <wires/>
  <measurementOrdering/>
</circuit>