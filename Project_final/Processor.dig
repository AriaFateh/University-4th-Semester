    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>reset and fetch protocol</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2885,0x2909,0x0194,0x33ff)

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
# after reset the PC is 0 and the first instruction is visible
0 0 0 0 0 0x0000 0x2885 0x0000 X X
# one clock pulse == exactly one instruction
C 0 0 0 0 X X X X X
0 0 0 0 0 0x0001 0x2909 X X X
