memory DMEM(19) = 0x0001;
memory DMEM(20) = 0x0028;
memory DMEM(21) = 0x0007;
memory DMEM(22) = 0x0002;
memory DMEM(23) = 0x001e;

0 0x0001 0 0 0 X X X X X
C 0x0001 0 0 0 X X X X X
0 0 0 0 0 0x0000 X X X X
loop(i,200)
C 0 0 0 0 X X X X X
end loop
# the program must have reached its final self-loop by now ...
0 0 0 0 0 0x000b X X X X
loop(i,5)
C 0 0 0 0 X X X X X
end loop
# ... and must stay there
0 0 0 0 0 0x000b X X X X
0 0 0x0001 0 0x0000 X X X X 0x0064
</dataString></testData></entry></elementAttributes><pos x="0" y="0"/></visualElement>
