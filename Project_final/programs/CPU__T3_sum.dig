    <visualElement><elementName>Testcase</elementName><elementAttributes><entry><string>Label</string><string>sum: all positive</string></entry><entry><string>Testdata</string><testData><dataString>CLK RESET DBG_EN DBG_RSEL DBG_MADDR PC_OUT IR_OUT FLAGS_OUT DBG_ROUT DBG_MOUT

program(0x2890,0x2908,0x2a00,0x0421,0x7005,0x2190,0x0246,0x1c91,0x1d2f,0x33f9,0x2600,0x33ff)
